{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PalStudio",
  "mainBinaryName": "palstudio",
  "identifier": "com.palstudio.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev:desktop",
      "cwd": "../ps-ui"
    },
    "beforeBuildCommand": {
      "script": "bun run build:desktop",
      "cwd": "../ps-ui"
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "http://127.0.0.1:5174"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Palworld save editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../ui_build": "ui",
      "../data": "data"
    },
    "macOS": {
      "hardenedRuntime": true,
      "dmg": {
        "background": "dmg/palstudio-dmg-background.png",
        "windowPosition": {
          "x": 180,
          "y": 120
        },
        "windowSize": {
          "width": 860,
          "height": 520
        },
        "appPosition": {
          "x": 220,
          "y": 302
        },
        "applicationFolderPosition": {
          "x": 640,
          "y": 302
        }
      }
    }
  }
}

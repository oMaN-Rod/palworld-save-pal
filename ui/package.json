{
	"name": "palworld-save-pal",
	"version": "0.0.1",
	"private": true,
	"license": "GPL-3.0-only",
	"scripts": {
		"dev:desktop": "node scripts/ensure-desktop-env.mjs && vite dev",
		"dev:web": "concurrently \"vite dev\" \"cd .. && cargo run -p psp-server -- --dev\"",
		"dev:vite": "vite dev",
		"dev:http2": "cross-env VITE_HTTPS=1 vite dev",
		"dev:wasm": "node scripts/ensure-web-env.mjs && node ../scripts/gen-json-manifest.mjs && cross-env VITE_TRANSPORT=worker vite dev",
		"build:wasm": "cd ../psp-web && wasm-pack build --target web --out-name psp --out-dir ../ui/src/lib/wasm/psp",
		"build": "node scripts/generate-sitemap.mjs && vite build",
		"build:desktop": "node scripts/ensure-desktop-env.mjs --force && vite build && node scripts/prune-desktop-build.mjs",
		"build:web": "node scripts/ensure-web-env.mjs && node ../scripts/gen-json-manifest.mjs && cd ../psp-web && wasm-pack build --target web --out-name psp --out-dir ../ui/src/lib/wasm/psp && cd ../ui && node scripts/generate-sitemap.mjs && cross-env VITE_TRANSPORT=worker vite build",
		"verify:build": "node scripts/check-build-output.mjs",
		"generate:sitemap": "node scripts/generate-sitemap.mjs",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:e2e:web": "playwright test --config playwright.web.config.ts",
		"test:unit": "vitest",
		"machine-translate": "inlang machine translate --project project.inlang"
	},
	"devDependencies": {
		"@iconify-json/line-md": "^1.2.16",
		"@iconify-json/ph": "^1.2.2",
		"@iconify-json/svg-spinners": "^1.2.4",
		"@iconify-json/tabler": "^1.2.38",
		"@inlang/cli": "^3.0.0",
		"@inlang/paraglide-js": "2.7.1",
		"@playwright/test": "^1.54.1",
		"@skeletonlabs/skeleton": "^3.1.7",
		"@skeletonlabs/skeleton-svelte": "^1.3.1",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/enhanced-img": "^0.3.10",
		"@sveltejs/kit": "^2.27.0",
		"@sveltejs/vite-plugin-svelte": "^6.1.0",
		"@tailwindcss/vite": "^4.1.11",
		"@types/d3-hierarchy": "^3.1.7",
		"@types/d3-selection": "^3.0.11",
		"@types/d3-transition": "^3.0.9",
		"@types/d3-zoom": "^3.0.8",
		"@types/eslint": "^9.6.1",
		"@types/node": "^20.19.9",
		"@types/three": "^0.185.1",
		"@types/uuid": "^10.0.0",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"concurrently": "^9.2.0",
		"cross-env": "^10.1.0",
		"eslint": "^9.32.0",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-svelte": "^2.46.1",
		"fake-indexeddb": "^6.2.5",
		"globals": "^15.15.0",
		"mdsvex": "^0.12.7",
		"prettier": "~3.6.2",
		"prettier-plugin-organize-imports": "^4.2.0",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"rehype-external-links": "^3.0.0",
		"rehype-slug": "^6.0.0",
		"sharp": "^0.35.3",
		"svelte": "^5.37.1",
		"svelte-check": "^3.8.6",
		"tailwindcss": "^4.1.11",
		"tslib": "^2.8.1",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.38.0",
		"unist-util-visit": "^5.1.0",
		"vite": "^7.0.6",
		"vitest": "^3.2.4"
	},
	"overrides": {
		"@zag-js/accordion": "1.3.1"
	},
	"type": "module",
	"dependencies": {
		"@humanspeak/svelte-virtual-list": "^0.5.2",
		"@iconify/svelte": "^5.2.2",
		"@monaco-editor/loader": "^1.7.0",
		"@number-flow/svelte": "^0.3.9",
		"@skeletonlabs/floating-ui-svelte": "^0.3.9",
		"@sqlite.org/sqlite-wasm": "^3.53.0-build1",
		"@sveltejs/vite-plugin-svelte-inspector": "^5.0.0",
		"@zag-js/types": "^1.21.1",
		"clsx": "^2.1.1",
		"cockatiel": "^4.0.0",
		"d3-hierarchy": "^3.1.2",
		"d3-selection": "^3.0.0",
		"d3-transition": "^3.0.1",
		"d3-zoom": "^3.0.0",
		"driver.js": "^1.4.0",
		"fflate": "^0.8.3",
		"maplibre-gl": "^5.17.0",
		"monaco-editor": "^0.55.1",
		"svelte-jsoneditor": "^3.11.0",
		"svelte-persisted-state": "^1.2.0",
		"tailwind-merge": "^2.6.0",
		"three": "^0.185.1",
		"uuid": "^11.1.0"
	},
	"trustedDependencies": [
		"@sveltejs/kit",
		"esbuild",
		"sharp",
		"svelte-preprocess"
	]
}

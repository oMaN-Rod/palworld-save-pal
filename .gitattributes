# SQL migrations must stay LF on every platform.
#
# `sqlx::migrate!` embeds each migration with `include_str!` and checksums the
# bytes as they sit on disk. With `core.autocrlf=true` (the Windows default) git
# rewrites them to CRLF on checkout, which changes the checksum and makes sqlx
# reject an already-applied migration with "migration N was previously applied
# but has been modified" -- even though the SQL is identical. Every existing
# database was migrated from LF files, so LF is the checksum that must hold.
*.sql text eol=lf

# Shell scripts must stay LF: CI runs them with `bash scripts/*.sh`, and a
# trailing CRLF makes `set -o pipefail` (and shebang resolution) fail with
# "invalid option name". `core.autocrlf=true` on Windows would otherwise rewrite
# committed scripts to CRLF.
*.sh text eol=lf

# Cloudflare parses `_headers` line by line and takes each header value as the
# rest of the line. Under `core.autocrlf=true` a Windows checkout rewrites it to
# CRLF, so a local `wrangler deploy` would ship `Cache-Control: ...\r` with the
# carriage return inside the header value.
_headers text eol=lf

# Same for `_redirects`: the status code is the last token on the line, so a
# CRLF checkout would ship `301\r` and Cloudflare would reject the config.
_redirects text eol=lf

# The generated LuaLS meta fixture is compared byte-for-byte against what
# `lua_meta` emits, which is LF. Under `core.autocrlf=true` a Windows checkout
# rewrites it to CRLF and `the_meta_file_matches_its_golden` fails on a clean
# tree, with a diff no regeneration can close.
psp-plugin/tests/fixtures/psp.lua text eol=lf

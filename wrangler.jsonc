{
	// Worker name stays `psp`: renaming would orphan the existing deployment.
	"name": "psp",
	"compatibility_date": "2026-08-02",
	"routes": [
		{
			"pattern": "palworldsavepal.app",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./ui_build",
		// Verified every static route is prerendered, so unknown URLs are genuinely
		// unknown and should say so rather than returning a 200 soft-404.
		"not_found_handling": "404-page"
	}
}
